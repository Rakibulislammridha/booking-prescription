# Build context for the Dockerfile. Everything the image needs is COPY'd from a clean checkout; nothing that is
# generated (vendor, node_modules, public/build) or machine-specific (the 166 MB dev-box `frankenphp` binary,
# .env, IDE state) may leak into it — the image builds those itself so it is the same on every host.
.git
.github
.gitattributes
.editorconfig

# Generated by the build stages inside the image, never taken from the host.
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/public/sw.js
/public/panel.webmanifest
/public/workbox-*.js
/public/frankenphp-worker.php
/bootstrap/cache/*.php

# Machine-specific.
/frankenphp
/frankenphp-worker.php
**/caddy
!/docker/caddy
/dragonfly.*
.env
.env.*
!.env.example
/auth.json
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/app/private/*
/storage/app/public/*
/storage/inertia-devtools
/storage/pail
.phpunit.result.cache
/.phpunit.cache
.phpactor.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
.DS_Store
Thumbs.db
*.log

# Not needed at runtime (tests run in CI, docs are read on GitHub). Keep phpunit.xml/phpstan.neon so an operator can
# `docker compose exec app vendor/bin/phpstan` in a debug image if they ever build one with dev dependencies.
/tests
/docs
/scripts/systemd
/scripts/deploy
/compose.yaml
/compose.*.yaml
/Dockerfile
