# Production environment for the compose stack (docs/DEPLOYMENT.md §4 documents every variable).
#
#   cp docker/.env.production.example .env      # on the VPS, next to compose.yaml
#
# ONE file feeds two readers: Docker Compose interpolates ${VAR} in compose.yaml from it, and every app container
# loads it as env_file. Values with spaces must be quoted. Hosts are compose SERVICE NAMES (postgres, valkey,
# meilisearch, minio) — point them at external services if you run those elsewhere.
#
# SECRETS (generate each one; never reuse a dev value). Lines marked `# [S] secret` below must be filled in:
#   APP_KEY               php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
#   BP_BACKUP_KEY         php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
#   REVERB_APP_SECRET     openssl rand -hex 24
#   MEILISEARCH_KEY       openssl rand -hex 32
#   POSTGRES_PASSWORD, DB_PASSWORD, CATALOG_DB_PASSWORD, CATALOG_ADMIN_DB_PASSWORD   openssl rand -hex 24 (each)
#   AWS_SECRET_ACCESS_KEY openssl rand -hex 24
#   VAPID_*               npx web-push generate-vapid-keys

# --- Compose ---------------------------------------------------------------------------------------------------
BP_IMAGE=ghcr.io/your-org/booking-prescription
BP_TAG=latest
# `minio` runs the bundled S3-compatible store; drop it when AWS_ENDPOINT points at an external S3/Wasabi/R2.
COMPOSE_PROFILES=minio
ACME_EMAIL=ops@example.com
# Superuser of the bundled postgres (only the initdb hook uses it; the app never logs in as it).       [S]
POSTGRES_PASSWORD=

# --- Application -----------------------------------------------------------------------------------------------
APP_NAME="Booking to Prescription"
APP_ENV=production
# [S] secret
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_CENTRAL_DOMAIN=example.com
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
# Previous APP_KEYs during a rotation (comma-separated); read-only decryption fallback. Empty normally.
APP_PREVIOUS_KEYS=

# Behind the edge Caddy on the compose network (fixed subnet in compose.yaml). X-Forwarded-Host stays untrusted:
# the Host header selects the tenant and Caddy forwards the original one unchanged.
TRUSTED_PROXIES=172.28.0.0/16
TRUSTED_PROXY_HOST_HEADER=false
OCTANE_HTTPS=true
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DAILY_DAYS=90

# --- Databases (docker/postgres/pg-roles.sql creates these roles on first start) --------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=booking
DB_USERNAME=bp_app
# [S] secret
DB_PASSWORD=
DB_SSLMODE=prefer

CATALOG_DB_HOST=postgres
CATALOG_DB_PORT=5432
CATALOG_DB_DATABASE=catalog
# Runtime role: SELECT only (BRIEF §3).
CATALOG_DB_USERNAME=bp_catalog_ro
# [S] secret
CATALOG_DB_PASSWORD=
# Admin role: catalog:migrate, catalog:import, custom-brand promotion.
CATALOG_ADMIN_DB_USERNAME=bp_catalog_admin
# [S] secret
CATALOG_ADMIN_DB_PASSWORD=
CATALOG_DB_SSLMODE=prefer

# --- Redis-compatible store (Valkey) ---------------------------------------------------------------------------
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=example.com,*.example.com

# --- Search ----------------------------------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
SCOUT_PREFIX=
MEILISEARCH_HOST=http://meilisearch:7700
# [S] secret
MEILISEARCH_KEY=

# --- Realtime (Reverb) ------------------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
# [S] secret
REVERB_APP_SECRET=
# What the BROWSER connects to: the edge Caddy's ws. host over TLS (docker/caddy/Caddyfile).
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_APP_PING_INTERVAL=30
REVERB_APP_ACTIVITY_TIMEOUT=30
# Where the reverb CONTAINER listens (Caddy proxies to reverb:8080).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Object storage (S3-compatible; MinIO when COMPOSE_PROFILES=minio) -----------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=bp
# [S] secret
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_BUCKET switches the `uploads` and `pdfs` disks to S3; AWS_BACKUPS_BUCKET switches `backups`.
AWS_BUCKET=bp-uploads
AWS_UPLOADS_BUCKET=bp-uploads
AWS_PDFS_BUCKET=bp-pdfs
AWS_BACKUPS_BUCKET=bp-backups
# Optional separate credential for the backups bucket (write-only key recommended); falls back to the pair above.
AWS_BACKUPS_ACCESS_KEY_ID=
AWS_BACKUPS_SECRET_ACCESS_KEY=

# --- Tenant backups (config/saas.php) --------------------------------------------------------------------------
# [S] secret
BP_BACKUP_KEY=

# --- Super console two-factor (config/saas.php) ---------------------------------------------------------------
SUPER_2FA_REQUIRED=true
SUPER_2FA_ISSUER=
HORIZON_DOMAIN=super.example.com

# --- Mail ------------------------------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
# [S] secret
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Booking to Prescription"

# --- Web push (VAPID) ------------------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
# [S] secret
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Payment gateways (platform-level fallback; clinics usually configure their own in the panel) ---------------
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_MODE=live
# NAGAD_MERCHANT_ID=
# NAGAD_MERCHANT_NUMBER=
# NAGAD_PUBLIC_KEY=
# NAGAD_PRIVATE_KEY=
# NAGAD_MODE=live
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_MODE=live

# --- Telemedicine (add-on; unset = null/log driver) -------------------------------------------------------------
# TELEMEDICINE_PROVIDER=livekit
# TELEMEDICINE_LIVEKIT_URL=
# TELEMEDICINE_LIVEKIT_KEY=
# TELEMEDICINE_LIVEKIT_SECRET=

# --- OCR (unset = local pdftotext only) -------------------------------------------------------------------------
# PATIENTS_OCR_DRIVER=google
# PATIENTS_OCR_KEY=
