APP_NAME="Booking to Prescription"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bp.localhost:8000
APP_CENTRAL_DOMAIN=bp.localhost

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=booking
DB_USERNAME=root
DB_PASSWORD=password

CATALOG_DB_HOST=127.0.0.1
CATALOG_DB_PORT=5432
CATALOG_DB_DATABASE=catalog
CATALOG_DB_USERNAME=root
CATALOG_DB_PASSWORD=password
CATALOG_ADMIN_DB_USERNAME=root
CATALOG_ADMIN_DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Idle timeout for the SUPER console only (minutes). Tenant staff use users.session_timeout_minutes
# falling back to the tenant setting security.session_timeout_minutes (BRIEF §5.N).
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT is auto-detected (phpredis when the extension is loaded, else predis).
# Set it explicitly only to force one client.
# REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=323166
REVERB_APP_KEY=t6l2utsy3qagsatiowil
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# REALTIME.md §1: ping every 30 s (Reverb defaults to 60) so a dead phone connection is spotted within ~60 s.
REVERB_APP_PING_INTERVAL=30
REVERB_APP_ACTIVITY_TIMEOUT=30

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

OCTANE_SERVER=frankenphp
HORIZON_DOMAIN=super.bp.localhost
SANCTUM_STATEFUL_DOMAINS=bp.localhost,*.bp.localhost

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

CHROME_PATH=/usr/bin/google-chrome
NODE_BINARY=/home/laralink/.nvm/versions/node/v23.11.0/bin/node
NPM_BINARY=/home/laralink/.nvm/versions/node/v23.11.0/bin/npm

# Web push (RFC 8292 VAPID) — App\Domain\Notifications\Services\VapidSigner, config/services.php `webpush`.
# ONE application-server key pair identifies the whole platform to the browsers' push services; it is generated
# per deployment, not per clinic, and the private key never enters the repo:
#     npx web-push generate-vapid-keys      (or any P-256 pair, base64url: 65-byte point / 32-byte scalar)
# Left empty the push channel falls back to the log driver, which is what local and CI want.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Payment gateways (config/billing.php). Commented out on purpose: with no credentials
# App\Domain\Billing\Gateways\GatewayConfig reports "not configured", online payment is not offered, and an
# explicit attempt raises GatewayNotConfigured. A clinic with its own merchant account sets these as tenant
# settings in the panel instead; the values below are the platform-level fallback.
# BILLING_GATEWAY_DRIVER=log        # 'log' = fake every gateway (local only; never in production)
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_MODE=sandbox                # 'live' switches to the production host; anything else is sandbox
# BKASH_BASE_URL=                   # staging proxy only; unset uses the driver's own sandbox/live host
# NAGAD_MERCHANT_ID=
# NAGAD_MERCHANT_NUMBER=
# NAGAD_PUBLIC_KEY=                 # Nagad's RSA public key (encrypt)
# NAGAD_PRIVATE_KEY=                # the merchant's RSA private key (sign)
# NAGAD_MODE=sandbox
# NAGAD_BASE_URL=
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_MODE=sandbox
# SSLCOMMERZ_BASE_URL=

# --- Telemedicine (add-on tier, BRIEF §5.K) -------------------------------------------------------------------
# Unset = the `null` (log) driver: real, short-lived tokens are minted and signed with APP_KEY, but no video
# service is ever contacted. That is what the test suite runs on. A clinic may override any of this per tenant in
# its own `telemedicine.*` settings rows (the secret is encrypted before it is stored).
# TELEMEDICINE_PROVIDER=livekit
# TELEMEDICINE_LIVEKIT_URL=wss://livekit.example.org
# TELEMEDICINE_LIVEKIT_KEY=
# TELEMEDICINE_LIVEKIT_SECRET=
# TELEMEDICINE_JITSI_DOMAIN=meet.example.org
# TELEMEDICINE_JITSI_APP_ID=
# TELEMEDICINE_JITSI_APP_SECRET=
# Agora: the App ID and App Certificate are 32 hex characters each; the Customer ID/Secret are the ACCOUNT's
# RESTful credential, needed only to kick a participant or close a channel.
# TELEMEDICINE_AGORA_APP_ID=
# TELEMEDICINE_AGORA_APP_CERTIFICATE=
# TELEMEDICINE_AGORA_CUSTOMER_ID=
# TELEMEDICINE_AGORA_CUSTOMER_SECRET=
# TELEMEDICINE_AGORA_REST_BASE=https://api.agora.io
# TELEMEDICINE_TOKEN_TTL=900
# TELEMEDICINE_MAX_MINUTES=45
# TELEMEDICINE_RECORDING=false

# --- Super-admin two-factor (config/saas.php, ARCHITECTURE §6.5) -----------------------------------------------
# TOTP on the `super` guard, REQUIRED by default: the platform console can impersonate into any clinic's patient
# records, so an operator who has not enrolled is held on the enrolment screen and can reach nothing else. Turn it
# off only where some other second factor already stands in front of super.{central} (an SSO proxy, a VPN) — the
# enrolment screen still works, it just stops being compulsory.
# SUPER_2FA_REQUIRED=true
# SUPER_2FA_ISSUER=                  # the name the authenticator app shows; empty follows APP_NAME

# --- Tenant backups (config/saas.php, ARCHITECTURE §8.2/§8.8) --------------------------------------------------
# The key every `tenants:backup` pg_dump is encrypted with before it reaches the `backups` disk
# (App\Domain\SaaS\Services\BackupCipher, libsodium crypto_secretstream_xchacha20poly1305). Base64 of 32 raw bytes:
#     php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# It is a PLATFORM key, not a per-tenant one, and it belongs in the deployment's secret store next to APP_KEY.
# Lose it and every dump written with it is unreadable — there is no recovery path, by design.
# Left empty, `local` and `testing` log a warning and write the dump in the CLEAR; every other environment
# refuses to back up at all and records the failure on the `tenant_backups` row.
BP_BACKUP_KEY=

# --- Uploaded-report OCR (config/patients.php, PRESCRIPTION.md §8) ---------------------------------------------
# Unset = no cloud engine. PDFs that already carry a text layer (what a lab's own software prints) are still read
# locally by `pdftotext` — free, offline, exact — and named "CBC – 06 Sep 2026"; PHOTOGRAPHED reports are named by
# type and upload date and marked `skipped`, exactly as before. That is what the test suite runs on.
# Set the driver to `google` AND supply a Google Cloud Vision API key to read photos too (billed per image, and
# every uploaded report then leaves the building — a data-sharing decision, not just a config change). A clinic may
# override both per tenant in its `patients.ocr_driver` / `patients.ocr_api_key` settings rows (the key is
# encrypted before it is stored). `PATIENTS_PDFTOTEXT_BIN=` (empty) disables the local text-layer path.
# PATIENTS_OCR_DRIVER=google
# PATIENTS_OCR_KEY=
# PATIENTS_OCR_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
# PATIENTS_OCR_TIMEOUT=15
# PATIENTS_PDFTOTEXT_BIN=/usr/bin/pdftotext
# PATIENTS_PDFTOTEXT_TIMEOUT=10
